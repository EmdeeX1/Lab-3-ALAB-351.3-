# Using a for loop
for_sum = 0
for i in range(1, 51):
    if i % 2 == 0:
        for_sum += i
print(f"Sum of even numbers from 1 to 50 is {for_sum}.")
# 2. Using a while loop:
while_sum = 0
i = 1
while i <= 50:
    if i % 2 == 0:
        while_sum += i
    i += 1
print(f"Sum of even numbers from 1 to 50 is {while_sum}.")
#Comparison and Comment
if for_sum == while_sum:
    print("Both loops produced the same result, which is correct.")
    print("The for loop is more concise, clearer and easier to read for this type of iteration. It handles the range and iteration automatically in one line, reducing the risk of infinite loops.")
